 Supabase).","operationId":"list_services","parameters":[{"name":"authorization","in":"header","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Authorization"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/ServiceResponse"},"title":"Response List Services"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/admin/brands":{"post":{"tags":["Admin"],"summary":"Create brand (admin)","description":"Admin-only: create a new brand using service role key (bypasses RLS).","operationId":"admin_create_brand","parameters":[{"name":"authorization","in":"header","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Authorization"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/BrandCreateRequest"}}}},"responses":{"201":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/BrandResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/admin/device-models":{"post":{"tags":["Admin"],"summary":"Create device model (admin)","description":"Admin-only: create a new device model under a brand using service role key (bypasses RLS).","operationId":"admin_create_device_model","parameters":[{"name":"authorization","in":"header","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Authorization"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/DeviceModelCreateRequest"}}}},"responses":{"201":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DeviceModelResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/admin/services":{"post":{"tags":["Admin"],"summary":"Create service (admin)","description":"Admin-only: create a new service using service role key (bypasses RLS).","operationId":"admin_create_service","parameters":[{"name":"authorization","in":"header","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Authorization"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ServiceCreateRequest"}}}},"responses":{"201":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ServiceResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}}},"components":{"schemas":{"AssignTechnicianRequest":{"properties":{"technician_id":{"type":"string","format":"uuid","title":"Technician Id","description":"User id of technician to assign."}},"type":"object","required":["technician_id"],"title":"AssignTechnicianRequest","description":"Admin payload to assign a technician to a repair."},"BrandCreateRequest":{"properties":{"name":{"type":"string","minLength":2,"title":"Name","description":"Brand name."}},"type":"object","required":["name"],"title":"BrandCreateRequest","description":"Admin payload to create a brand."},"BrandResponse":{"properties":{"id":{"type":"string","format":"uuid","title":"Id","description":"Brand id."},"name":{"type":"string","title":"Name","description":"Brand name."}},"type":"object","required":["id","name"],"title":"BrandResponse","description":"Brand record for booking catalog."},"DeviceModelCreateRequest":{"properties":{"brand_id":{"type":"string","format":"uuid","title":"Brand Id","description":"Brand id this model belongs to."},"name":{"type":"string","minLength":2,"title":"Name","description":"Device model name."}},"type":"object","required":["brand_id","name"],"title":"DeviceModelCreateRequest","description":"Admin payload to create a device model under a brand."},"DeviceModelResponse":{"properties":{"id":{"type":"string","format":"uuid","title":"Id","description":"Device model id."},"brand_id":{"type":"string","format":"uuid","title":"Brand Id","description":"Brand id this model belongs to."},"name":{"type":"string","title":"Name","description":"Device model name."}},"type":"object","required":["id","brand_id","name"],"title":"DeviceModelResponse","description":"Device model record for booking catalog."},"HTTPValidationError":{"properties":{"detail":{"items":{"$ref":"#/components/schemas/ValidationError"},"type":"array","title":"Detail"}},"type":"object","title":"HTTPValidationError"},"RepairCreateRequest":{"properties":{"brand_id":{"type":"string","format":"uuid","title":"Brand Id","description":"Selected brand id."},"device_model_id":{"type":"string","format":"uuid","title":"Device Model Id","description":"Selected device model id."},"service_id":{"type":"string","format":"uuid","title":"Service Id","description":"Requested service id."},"issue_description":{"type":"string","minLength":5,"title":"Issue Description","description":"Customer-reported issue."},"address":{"type":"string","minLength":5,"title":"Address","description":"Pickup/dropoff address."},"contact_phone":{"type":"string","minLength":6,"title":"Contact Phone","description":"Contact phone number."}},"type":"object","required":["brand_id","device_model_id","service_id","issue_description","address","contact_phone"],"title":"RepairCreateRequest","description":"Payload for creating a repair booking."},"RepairResponse":{"properties":{"id":{"type":"string","format":"uuid","title":"Id","description":"Repair id."},"status":{"type":"string","title":"Status","description":"Current repair status."},"customer_id":{"type":"string","format":"uuid","title":"Customer Id","description":"Customer user id."},"technician_id":{"anyOf":[{"type":"string","format":"uuid"},{"type":"null"}],"title":"Technician Id","description":"Assigned technician user id."},"brand_id":{"type":"string","format":"uuid","title":"Brand Id","description":"Brand id."},"device_model_id":{"type":"string","format":"uuid","title":"Device Model Id","description":"Device model id."},"service_id":{"type":"string","format":"uuid","title":"Service Id","description":"Service id."},"issue_description":{"type":"string","title":"Issue Description","description":"Issue description."},"address":{"type":"string","title":"Address","description":"Address."},"contact_phone":{"type":"string","title":"Contact Phone","description":"Contact phone."},"created_at":{"anyOf":[{"type":"string","format":"date-time"},{"type":"null"}],"title":"Created At","description":"Creation time."},"updated_at":{"anyOf":[{"type":"string","format":"date-time"},{"type":"null"}],"title":"Updated At","description":"Last update time."}},"type":"object","required":["id","status","customer_id","brand_id","device_model_id","service_id","issue_description","address","contact_phone"],"title":"RepairResponse","description":"Repair record returned to clients."},"RepairStatusHistoryResponse":{"properties":{"id":{"type":"string","format":"uuid","title":"Id","description":"History record id."},"repair_id":{"type":"string","format":"uuid","title":"Repair Id","description":"Linked repair id."},"status":{"type":"string","title":"Status","description":"Status value at this point in time."},"created_at":{"anyOf":[{"type":"string","format":"date-time"},{"type":"null"}],"title":"Created At","description":"Timestamp of status change."}},"type":"object","required":["id","repair_id","status"],"title":"RepairStatusHistoryResponse","description":"Repair status history record."},"RepairStatusUpdateRequest":{"properties":{"status":{"type":"string","title":"Status","description":"New status (e.g. pending, accepted, in_progress, completed, cancelled)."}},"type":"object","required":["status"],"title":"RepairStatusUpdateRequest","description":"Payload to update a repair's status."},"ServiceCreateRequest":{"properties":{"name":{"type":"string","minLength":2,"title":"Name","description":"Service name."},"base_price":{"anyOf":[{"type":"number","minimum":0.0},{"type":"null"}],"title":"Base Price","description":"Base price (informational)."}},"type":"object","required":["name"],"title":"ServiceCreateRequest","description":"Admin payload to create a service."},"ServiceResponse":{"properties":{"id":{"type":"string","format":"uuid","title":"Id","description":"Service id."},"name":{"type":"string","title":"Name","description":"Service name."},"base_price":{"anyOf":[{"type":"number"},{"type":"null"}],"title":"Base Price","description":"Base price (informational)."}},"type":"object","required":["id","name"],"title":"ServiceResponse","description":"Service record for booking catalog."},"UserContext":{"properties":{"user_id":{"type":"string","format":"uuid","title":"User Id","description":"Supabase auth user id (auth.users.id)."},"email":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Email","description":"User email from Supabase auth."},"role":{"type":"string","title":"Role","description":"Application role: customer, technician, admin."},"access_token":{"type":"string","title":"Access Token","description":"Raw Supabase access token (JWT)."}},"type":"object","required":["user_id","role","access_token"],"title":"UserContext","description":"User identity and role derived from Supabase Auth + profiles table."},"ValidationError":{"properties":{"loc":{"items":{"anyOf":[{"type":"string"},{"type":"integer"}]},"type":"array","title":"Location"},"msg":{"type":"string","title":"Message"},"type":{"type":"string","title":"Error Type"}},"type":"object","required":["loc","msg","type"],"title":"ValidationError"}}},"tags":[{"name":"System","description":"Health checks and operational endpoints."},{"name":"Catalog","description":"Read-only catalog data (brands, device models, services) used by booki